# Godot 4+ specific ignores
.godot/
/android/

# Godot-specific ignores (Godot 3.x, kept for safety)
.import/
export.cfg
export_presets.cfg

# Imported translations (auto-generated from CSV files)
*.translation

# Mono-specific ignores (if using C#)
.mono/
data_*/
mono_crash.*.json

# Exported game builds (don't commit binaries to git)
/builds/
/export/
*.exe
*.pck
*.zip

# Local reference/scratch material (raw asset downloads to copy from, not shipped)
/reference/

# OS-specific junk files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Editor/IDE folders (uncomment whichever you use)
.vscode/
# .idea/

# Third-party asset packs (local source library). Not redistributed — the game only
# commits the few derived sprites it actually uses (see assets/node_sprites/README.md).
/assets/thirdparty/

# Screenshot harness output (tools/screenshot.gd) — regenerable, not source.
/screenshots/
